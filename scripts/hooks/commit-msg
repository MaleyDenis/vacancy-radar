#!/bin/bash
# Conventional Commits: <type>(<scope>): <description>
# No ticket numbers, no PR numbers, no trailing period, max 70 chars.
SUBJECT=$(head -1 "$1")

# Let git's own merge/revert/fixup messages through.
if [[ "$SUBJECT" =~ ^(Merge|Revert|fixup!|squash!) ]]; then
  exit 0
fi

PATTERN='^(feat|fix|refactor|docs|style|test|chore)\([a-z0-9-]+\): [a-z0-9].*[^.]$'

fail() {
  echo "❌ $1" >&2
  echo "   Subject: '$SUBJECT'" >&2
  echo "" >&2
  echo "   Expected: <type>(<scope>): <description>" >&2
  echo "   Types:    feat fix refactor docs style test chore" >&2
  echo "   Example:  feat(scan): add evaluate step" >&2
  exit 1
}

if [[ ${#SUBJECT} -gt 70 ]]; then
  fail "Subject too long: ${#SUBJECT} chars (max 70)"
fi
if [[ "$SUBJECT" =~ \(#[0-9]+\)$ ]]; then
  fail "No PR number at the end"
fi
if [[ "$SUBJECT" =~ VR-[0-9]+ ]]; then
  fail "No ticket numbers"
fi
if ! [[ "$SUBJECT" =~ $PATTERN ]]; then
  fail "Invalid commit message"
fi

exit 0
