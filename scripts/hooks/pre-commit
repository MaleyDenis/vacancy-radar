#!/bin/bash
# Branch naming: <type>/<short-slug>, e.g. feat/evaluate-step. No commits on main.
BRANCH=$(git branch --show-current)

if [[ "$BRANCH" =~ ^(main|master|develop)$ ]]; then
  echo "❌ Blocked: cannot commit directly to '$BRANCH'" >&2
  exit 1
fi

if ! [[ "$BRANCH" =~ ^(feat|fix|refactor|docs|style|test|chore)/[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  echo "❌ Invalid branch name: '$BRANCH'" >&2
  echo "" >&2
  echo "   Expected: <type>/<short-slug>" >&2
  echo "   Types:    feat fix refactor docs style test chore" >&2
  echo "   Example:  feat/evaluate-step" >&2
  exit 1
fi

exit 0
